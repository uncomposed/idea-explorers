{
  "name": "proximity-idea-explorers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-models": "node scripts/generate-models.mjs",
    "dev": "npm run prepare-models && vite --host 127.0.0.1",
    "build": "npm run prepare-models && tsc -b && vite build && node scripts/package-routes.mjs",
    "check": "npm run prepare-models && tsc -b",
    "verify": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "yaml": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
